# Documentation template only. The app reads server environment variables, not
# this file automatically. Never put a real key in client JavaScript or commit it.
KALENDS_AI_PROVIDER=offline
# Values: offline, mock, openai_responses, local_json

# These remain zero/off until the owner explicitly authorizes an API credential
# source and spending budget. An API key alone does not authorize spending.
KALENDS_AI_ALLOW_EXTERNAL=0
KALENDS_AI_BUDGET_USD=0
OPENAI_API_KEY=
KALENDS_AI_MODEL=
# Enter current explicit model rates before enabling a real provider. -1 blocks.
KALENDS_AI_INPUT_USD_PER_MILLION=-1
KALENDS_AI_OUTPUT_USD_PER_MILLION=-1

# Optional loopback server must implement rebirth-cognition-1. This is not an
# assumption that an arbitrary local endpoint implements OpenAI/Ollama APIs.
KALENDS_AI_ALLOW_LOCAL=0
KALENDS_AI_LOCAL_ENDPOINT=http://127.0.0.1:11434/kalends

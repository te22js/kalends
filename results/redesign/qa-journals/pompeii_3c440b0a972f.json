    "opportunities": [
      {
        "at": 0,
        "label": "Hear a private account of the disputed six-sack cart."
      },
      {
        "at": 240,
        "label": "Compare a deadline with current stock, price and any accepted promise."
      },
      {
        "at": 1440,
        "label": "Review the first day of actual work and obligations."
      },
      {
        "at": 43200,
        "label": "Return after a month and inspect the generated personal history."
      },
      {
        "at": 129600,
        "label": "Revisit one earlier accepted decision and compare a replayed alternative."
      }
    ],
    "horizon_minutes": 172800,
    "termination": {
      "at": 172800
    },
    "measures": [
      "cash",
      "inventory",
      "reputation",

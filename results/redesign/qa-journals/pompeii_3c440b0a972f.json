      "service_minutes",
      "completed_commissions",
      "elapsed_days",
      "fulfilled_obligations",
      "missed_obligations"
    ],
    "debrief": {
      "objective": "Reason about asymmetric information, resource-backed promises, social constraints and the later consequences of accepted actions. Historical participation is not evidence of real-world learning transfer.",
      "questions": [
        "Which account could you legitimately access before committing, and which was still private?",
        "Which accepted choice moved actual coins, flour or service time? Cite its event.",
        "What changed after your absence, and which actual events support that explanation?",
        "Which alternative can the same command history replay, and which later actions become infeasible?"
      ],
      "transfer": {
        "prompt": "In an unfamiliar cooperative, two buyers repeat a supplier story from the same original witness. Before accepting a deadline-backed order, which is the strongest next step?",
        "options": [
          "Treat the repeated reports as two independent confirmations.",
          "Check a current primary record, then compare quantity, cost and the actual deadline.",
          "Assume the supplier has stock because they sounded confident."
        ],
        "answer": 1,
        "rationale": "Repeated testimony may share one source. A current check can reduce uncertainty, but its cost and the resources required by the promise must still be evaluated."
      }
    },
